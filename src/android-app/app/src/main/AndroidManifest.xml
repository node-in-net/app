<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GTK brings a presented window's task to the front (ActivityManager.moveTaskToFront). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Local files and shared folders are real paths in the native code, as in the Kotlin client. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name="net.nodeinnet.gtk.NodeInNetApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NodeInNet">

        <!-- lib<value>.so must export main(); GTK's RuntimeApplication runs it on the GTK thread. -->
        <meta-data android:name="gtk.android.lib_name" android:value="nodeinnet_android" />

        <activity
            android:name="org.gtk.android.ToplevelActivity"
            android:configChanges="density|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.nodeinnet.gtk.BrowserActivity"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="false" />
    </application>
</manifest>
